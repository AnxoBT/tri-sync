# Copia este archivo como .env y rellénalo. El .env NUNCA se sube a GitHub.

# Carpeta donde dejas los exports de Dixmax (playmax-userdata-*) y Letterboxd (letterboxd-*)
DATA_DIR=data

# Serializd: valor de la cookie "tvproject_credentials" (serializd.com > F12 > Application > Cookies)
SERIALIZD_TOKEN=

# Usuario de Serializd y de Letterboxd
SERIALIZD_USER=
LETTERBOXD_USER=

# Dixmax/PlayMax: cookie de sesión (fase 2, para aplicar cambios)
DIXMAX_COOKIE=
