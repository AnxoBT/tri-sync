# Copia este archivo como .env y rellénalo. El .env NUNCA se sube a GitHub.

# Carpeta donde dejas los exports de Dixmax (playmax-userdata-*) y Letterboxd (letterboxd-*)
DATA_DIR=data

# Serializd: valor de la cookie "tvproject_credentials" (serializd.com > F12 > Application > Cookies)
SERIALIZD_TOKEN=

# Usuario de Serializd y de Letterboxd
SERIALIZD_USER=
LETTERBOXD_USER=

# Dixmax/PlayMax (solo para APLICAR cambios en Dixmax). En playmax.mx con sesión iniciada:
#   F12 > Network > recarga > clic en cualquier petición a /api/json/...
#   DIXMAX_COOKIE  = valor completo de la cabecera "cookie" (Request Headers)
#   DIXMAX_API_KEY = el código de la URL: /api/json/get/<nombre>/v1/<ESTE_CODIGO>/
DIXMAX_COOKIE=
DIXMAX_API_KEY=
