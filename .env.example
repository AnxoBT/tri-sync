# Copia este archivo como .env y rellénalo. El .env NUNCA se sube a GitHub.

# Carpeta donde dejas los exports de Dixmax (playmax-userdata-*) y Letterboxd (letterboxd-*)
DATA_DIR=data

# Serializd: valor de la cookie "tvproject_credentials" (serializd.com > F12 > Application > Cookies)
SERIALIZD_TOKEN=

# Usuario de Serializd y de Letterboxd
SERIALIZD_USER=
LETTERBOXD_USER=

# Dixmax/PlayMax: API oficial v2 (solo para APLICAR cambios en Dixmax)
#   DIXMAX_API_KEY  = apiKey de tu app (playmax.mx/tusapps.php > Añadir App)
#   DIXMAX_AUTH_KEY = authKey de tu usuario (Panel de Control > Aplicaciones autorizadas)
DIXMAX_API_KEY=
DIXMAX_AUTH_KEY=
